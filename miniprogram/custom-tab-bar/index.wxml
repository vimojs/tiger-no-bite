<view class="tabbar-container">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        {{item.icon}}
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
