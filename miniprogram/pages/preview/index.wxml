<view class="preview-page">
  <view class="stage">
    <view class="stage-room" wx:if="{{!cameraActive}}">
      <view class="stage-glow" wx:if="{{!cameraActive}}" style="opacity: {{lightBeamOpacity}}"></view>
      <view class="stage-window">

        <view class="stage-glass" wx:if="{{!cameraActive}}">
          <!-- 左侧真实花色 -->
          <view class="stage-curtain left">
            <image class="stage-curtain-texture" src="{{selectedTexture}}" mode="aspectFill" />
          </view>

          <!-- 右侧真实花色 -->
          <view class="stage-curtain right">
            <image class="stage-curtain-texture" src="{{selectedTexture}}" mode="aspectFill" />
          </view>

          <view class="stage-cross"></view>
        </view>

      </view>
      <view class="stage-floor" wx:if="{{!cameraActive}}"></view>
      <view class="stage-plant" wx:if="{{!cameraActive}}">
        <view class="leaves"></view>
        <view class="pot"></view>
      </view>
      <view class="recognition" wx:if="{{!cameraActive}}">
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view><text>窗户区域示意</text>
      </view>
    </view>
    <ar-curtain wx:if="{{cameraActive}}" id="arCurtain" class="ar-curtain" selected-id="{{selectedId}}" width="{{curtainWidth}}" height="{{curtainHeight}}" transmission="{{transmission}}" ambient-light="{{ambientLight}}" closed="{{curtainClosed}}" bind:arstatus="onARStatus" />
    <view class="stage-top">
      <view class="status-pill">
        <view class="status-dot"></view>{{statusText}}
      </view>
      <view class="camera-button" bindtap="toggleCamera">{{cameraActive ? '×' : '◎'}}</view>
    </view>
    <view class="stage-bottom-tools">
      <view class="tool" bindtap="resetARPlacement" wx:if="{{cameraActive && curtainPlaced && !cameraOnlyDiagnostic}}"><text class="tool-icon">⌖</text><text>重新放置</text></view>
      <view class="tool" bindtap="toggleCurtain" wx:if="{{cameraActive && !cameraOnlyDiagnostic}}">
        <text class="tool-icon">{{curtainClosed ? '◧' : '◨'}}</text>
        <text>{{curtainClosed ? '打开窗帘' : '关闭窗帘'}}</text>
      </view>
      <view class="tool" bindtap="toggleCamera">
        <text class="tool-icon">{{cameraActive ? '×' : '◉'}}</text>
        <text>{{cameraActive ? '关闭摄像头' : '开启摄像头'}}</text>
      </view>
      <view class="tool" bindtap="savePlan"><text class="tool-icon">♡</text><text>保存方案</text></view>
    </view>
  </view>
  <view class="selector">
    <view class="selector-head">
      <view><text class="selector-title">挑选你的窗帘</text><text class="selector-sub">点击款式，即时查看搭配</text></view><text class="more" bindtap="showProduct">商品详情 →</text>
    </view>

    <scroll-view scroll-x class="category-scroll">
      <view class="category-row">
        <text wx:for="{{categories}}" wx:key="*this" class="category {{selectedCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</text>
      </view>
    </scroll-view>

    <scroll-view scroll-x class="swatch-scroll">
      <view class="swatch-row">
        <view wx:for="{{filteredProducts}}" wx:key="id" class="swatch-item {{selectedId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseProduct">
          <view class="swatch-image">
            <image class="swatch-texture" src="{{item.texture}}" mode="aspectFill" />
            <view wx:if="{{selectedId === item.id}}" class="check">✓</view>
          </view>

          <text class="swatch-name">{{item.name}}</text>
          <text class="swatch-price">¥{{item.price}}/㎡</text>
        </view>
      </view>
    </scroll-view>

    <view class="selected-line">
      <view><text class="selected-name">{{selectedName}}</text><text class="selected-note">示意预览，最终以实物面料为准</text></view><button class="use-btn" bindtap="showProduct">查看商品</button>
    </view>
    <view class="light-controls" wx:if="{{!cameraActive || !cameraOnlyDiagnostic}}">
      <block wx:if="{{cameraActive}}">
        <view class="light-control-head"><text>窗帘宽度</text><text>{{curtainWidthLabel}} m</text></view>
        <slider min="0.6" max="3" step="0.1" value="{{curtainWidth}}" activeColor="#b58b64" block-size="18" bindchange="changeCurtainWidth" />
        <view class="light-control-head"><text>窗帘高度</text><text>{{curtainHeightLabel}} m</text></view>
        <slider min="0.6" max="3" step="0.1" value="{{curtainHeight}}" activeColor="#b58b64" block-size="18" bindchange="changeCurtainHeight" />
      </block>
      <view class="light-control-head"><text>光线模拟 · {{lightLabel}}</text><text>{{ambientLight}}%</text></view>
      <slider min="0" max="100" value="{{ambientLight}}" activeColor="#b58b64" block-size="18" bindchanging="changeAmbientLight" bindchange="changeAmbientLight" />
      <view class="light-control-head"><text>面料透光模拟</text><text>{{transmission}}%</text></view>
      <slider min="0" max="100" value="{{transmission}}" activeColor="#b58b64" block-size="18" bindchanging="changeTransmission" bindchange="changeTransmission" />
      <text class="simulation-note">光线与透光率为视觉模拟值，不代表实测照度或商品检测数据</text>
    </view>
  </view>
</view>
