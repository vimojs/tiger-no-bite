<view class="page profile-page">
  <view class="profile-head"><view class="profile-avatar">帘</view><view class="profile-user"><text class="user-name">欢迎来到帘境</text><text class="user-sub">把喜欢的家居灵感收藏起来</text></view><text class="profile-arrow">›</text></view>
  <view class="stats card"><view class="stat"><text class="stat-num">{{plan ? 1 : 0}}</text><text class="stat-label">我的方案</text></view><view class="stat-divider"></view><view class="stat"><text class="stat-num">0</text><text class="stat-label">我的收藏</text></view><view class="stat-divider"></view><view class="stat"><text class="stat-num">0</text><text class="stat-label">浏览记录</text></view></view>
  <view class="section-head"><text class="section-title">我的搭配方案</text><text class="link" bindtap="openPreview">继续试搭 →</text></view>
  <view wx:if="{{plan}}" class="saved-plan card"><view class="saved-thumb"><view class="saved-curtain"></view></view><view class="saved-info"><text class="saved-name">{{plan.productName}}</text><text class="saved-time">最近保存的方案</text><text class="saved-action" bindtap="openPreview">继续编辑 →</text></view></view>
  <view wx:else class="empty card"><view class="empty-icon">⌂</view><text class="empty-title">还没有保存方案</text><text class="empty-desc">试试不同的窗帘，把喜欢的搭配留下来</text><button class="empty-btn" bindtap="openPreview">开始 AI 试搭</button></view>
  <view class="section-head"><text class="section-title">更多服务</text></view>
  <view class="menu card"><view class="menu-item" data-name="我的收藏" bindtap="showFeature"><text class="menu-icon">♡</text><text class="menu-label">我的收藏</text><text class="menu-arrow">›</text></view><view class="menu-item" data-name="预约测量" bindtap="showFeature"><text class="menu-icon">⌖</text><text class="menu-label">预约测量</text><text class="menu-arrow">›</text></view><view class="menu-item" data-name="帮助与反馈" bindtap="showFeature"><text class="menu-icon">?</text><text class="menu-label">帮助与反馈</text><text class="menu-arrow">›</text></view></view>
  <view class="foot-note">帘境 · 让每一扇窗，都有喜欢的样子</view>
</view>
