<!-- Camera-only baseline: isolate XR-Frame video rendering from VisionKit plane tracking. -->
<xr-scene
  id="curtain-scene"
  ar-system
  bind:ready="handleReady"
  bind:ar-ready="handleARReady"
  bind:ar-error="handleARError"
>
  <xr-node>
    <xr-node node-id="camera-target" position="0 0 0" />
    <xr-camera
      id="ar-camera"
      node-id="ar-camera"
      position="2 1 2"
      background="ar"
      target="camera-target"
      camera-orbit-control=""
    />
  </xr-node>
</xr-scene>
